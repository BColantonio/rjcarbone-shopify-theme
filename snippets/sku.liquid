{%- doc -%}
  This snippet is used to render a product SKU.
  It is used in the sku block.

  @param {product} product_resource - The product to render
  @param {boolean} [show_label] - Whether to prefix the SKU with a translated label

  @example
  {% render 'sku', product_resource: closest.product, show_label: true %}
{%- enddoc -%}

{%- liquid
  assign sku = product_resource.selected_or_first_available_variant.sku
-%}

<div ref="skuContainer">
  <span
    class="sku"
    data-testid="product-sku"
  >
    {%- if show_label -%}
      <span class="sku__label">{{ 'products.product.sku_label' | t }}</span>&#32;
    {%- endif -%}
    <bdi ref="sku">{{- sku -}}</bdi>
  </span>
</div>
