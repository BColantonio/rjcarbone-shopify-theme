{%- doc -%}
  Returns the confirmed Roses department handle for one of its category collections.
  @param {string} collection_handle - The category collection handle.
  @example
  {% render 'floral-department-back-link-roses', collection_handle: collection.handle %}
{%- enddoc -%}
{%- case collection_handle -%}
  {%- when 'garden-roses' -%}
    roses
  {%- when 'rose-color-40cm' -%}
    roses
  {%- when 'rose-color-50cm' -%}
    roses
  {%- when 'rose-color-60cm' -%}
    roses
  {%- when 'rose-color-70cm' -%}
    roses
  {%- when 'rose-color-80cm' -%}
    roses
  {%- when 'rose-red-50cm' -%}
    roses
  {%- when 'rose-red-60cm' -%}
    roses
  {%- when 'spray-roses' -%}
    roses
{%- endcase -%}
