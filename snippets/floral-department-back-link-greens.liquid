{%- doc -%}
  Returns the confirmed Greens department handle for one of its category collections.
  @param {string} collection_handle - The category collection handle.
  @example
  {% render 'floral-department-back-link-greens', collection_handle: collection.handle %}
{%- enddoc -%}
{%- case collection_handle -%}
  {%- when 'aspidistra' -%}
    greens
  {%- when 'bear-grass' -%}
    greens
  {%- when 'curly-willow' -%}
    greens
  {%- when 'emerald' -%}
    greens
  {%- when 'eucalyptus' -%}
    greens
