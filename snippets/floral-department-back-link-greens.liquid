{%- doc -%}
  Renders the Back to Greens link for one of its confirmed category collections.
  @param {string} collection_handle - The category collection handle.
  @example
  {% render 'floral-department-back-link-greens', collection_handle: collection.handle %}
{%- enddoc -%}
{%- case collection_handle -%}
