    greens
  {%- when 'nagi-fern' -%}
    greens
  {%- when 'novelty-greens' -%}
    greens
  {%- when 'penny-cress' -%}
    greens
  {%- when 'pittosporum-greens' -%}
    greens
  {%- when 'plumosa' -%}
