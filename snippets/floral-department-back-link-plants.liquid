{%- doc -%}
  Returns the confirmed Plants department handle for one of its category collections.
  @param {string} collection_handle - The category collection handle.
  @example
  {% render 'floral-department-back-link-plants', collection_handle: collection.handle %}
{%- enddoc -%}
