

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}
    {% if section.settings.section_height != "" %} {{ section.settings.section_height | prepend: "section--height-" }}{% endif %}
  "
>
  <div>
    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--column
        section-content-wrapper
        mobile-column
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      <div class="main-404">
        <h1 class="h3">{{ 'page_404.heading' | t }}</h1>
        <p>{{ 'page_404.explanation' | t }}</p>
        <form action="{{ routes.search_url }}" method="get" role="search" class="main-404__search">
          <label for="Search404-{{ section.id }}">{{ 'content.search_input_label' | t }}</label>
          <div class="main-404__search-controls">
            <input id="Search404-{{ section.id }}" type="search" name="q" placeholder="{{ 'content.search_input_placeholder' | t | escape }}">
            <button type="submit" class="button">{{ 'content.search' | t }}</button>
          </div>
        </form>
        <a class="button button-secondary" href="{{ routes.root_url }}">{{ 'page_404.back_to_home' | t }}</a>
        <nav aria-label="{{ 'page_404.departments' | t | escape }}">
          <ul class="main-404__links" role="list">
            <li><a href="{{ routes.collections_url }}/flowers">{{ 'page_404.flowers' | t }}</a></li>
            <li><a href="{{ routes.collections_url }}/roses">{{ 'page_404.roses' | t }}</a></li>
            <li><a href="{{ routes.collections_url }}/greens">{{ 'page_404.greens' | t }}</a></li>
            <li><a href="{{ routes.collections_url }}/plants">{{ 'page_404.plants' | t }}</a></li>
            <li><a href="{{ routes.collections_url }}/supplies">{{ 'page_404.supplies' | t }}</a></li>
          </ul>
        </nav>
      </div>
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .main-404 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-lg);
    width: min(100%, 36rem);
    min-width: 0;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .main-404 h1,
  .main-404 p {
    margin: 0;
  }

  .main-404__search {
    width: 100%;
    text-align: start;
  }

  .main-404__search-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    margin-block-start: var(--margin-xs);
  }

  .main-404__search input {
    flex: 1 1 12rem;
    min-width: 0;
    padding: var(--padding-md);
    color: var(--color-input-text);
    background: var(--color-input-background);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);
  }

  .main-404__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-sm) var(--gap-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-404__links a {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .main-404 :is(a, button, input):focus-visible {
    outline: 3px solid var(--color-foreground);
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.404",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.horizontal_alignment_flex_direction_column == 'fake-value' }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
