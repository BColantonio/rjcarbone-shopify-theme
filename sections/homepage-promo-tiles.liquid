{% comment %}
  Renders configurable promotional image tiles for homepage composition.
  @example
  Add promo_tile blocks with an external image URL, alt text, and destination link.
{% endcomment %}
{% assign has_tiles = false %}
{% for block in section.blocks %}
  {% if block.settings.external_image_url != blank or block.settings.image != blank or block.settings.heading != blank or block.settings.text != blank %}
    {% assign has_tiles = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% if has_tiles %}
  <section
    class="section section--{{ section.settings.section_width }} spacing-style homepage-promo-tiles"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="homepage-promo-tiles__grid">
      {% for block in section.blocks %}
        {% liquid
          assign tile_image_url = block.settings.external_image_url | strip
          assign tile_image_alt = block.settings.external_image_alt | default: block.settings.image.alt | default: block.settings.heading
          assign tile_cache_separator = '?'
          assign tile_cache_version = 'now' | date: '%Y%m%d'
          if tile_image_url contains '?'
            assign tile_cache_separator = '&'
          endif
          if tile_image_url != blank
            assign tile_image_url = tile_image_url | append: tile_cache_separator | append: 'v=' | append: tile_cache_version
          endif
        %}
        {% if tile_image_url != blank or block.settings.image != blank or block.settings.heading != blank or block.settings.text != blank %}
          <article class="homepage-promo-tile" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a
                class="homepage-promo-tile__link"
                href="{{ block.settings.link | escape }}"
                {% if block.settings.open_in_new_tab %}
                  target="_blank"
                  rel="noopener"
                {% endif %}
              >
            {% else %}
              <div class="homepage-promo-tile__content">
            {% endif %}

            {% if tile_image_url != blank %}
              <img
                class="homepage-promo-tile__image"
                src="{{ tile_image_url | escape }}"
                alt="{{ tile_image_alt | escape }}"
                width="1200"
                height="600"
                loading="lazy"
              >
            {% elsif block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '320, 480, 640, 960, 1200',
                  sizes: '(min-width: 990px) 40vw, 100vw',
                  loading: 'lazy',
                  class: 'homepage-promo-tile__image',
                  alt: tile_image_alt
              }}
            {% else %}
              <div class="homepage-promo-tile__image homepage-promo-tile__image--placeholder" aria-hidden="true">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="homepage-promo-tile__caption">
              {% if block.settings.heading != blank %}
                <h2 class="homepage-promo-tile__heading">{{ block.settings.heading | escape }}</h2>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="homepage-promo-tile__text rte">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.link_label != blank %}
                <span class="homepage-promo-tile__link-label">{{ block.settings.link_label | escape }}</span>
              {% endif %}
            </div>

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .homepage-promo-tiles__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-md);
  }

  .homepage-promo-tile {
    min-width: 0;
    min-height: 235px;
    overflow: hidden;
    background: #ccc;
  }

  .homepage-promo-tile__link,
  .homepage-promo-tile__content {
    display: block;
    position: relative;
    min-height: 235px;
    color: inherit;
    text-decoration: none;
  }

  .homepage-promo-tile__image {
    display: block;
    width: 100%;
    height: 235px;
    object-fit: cover;
    object-position: center;
  }

  .homepage-promo-tile__image--placeholder {
    position: absolute;
    inset: 0;
    height: 100%;
    color: #777;
  }

  .homepage-promo-tile__caption {
    position: absolute;
    inset-inline: 30px;
    bottom: 20px;
    color: #fff;
    font-size: clamp(1.5rem, 2.4vw, 2.1875rem);
    line-height: 0.9;
    text-shadow: 3px 4px 4px rgb(0 0 0 / 80%);
    overflow-wrap: anywhere;
  }

  .homepage-promo-tile__heading {
    margin: 0;
    color: inherit;
    font: inherit;
    line-height: inherit;
  }

  .homepage-promo-tile__text {
    margin-block-start: var(--gap-xs);
    color: inherit;
    font-size: 1rem;
    line-height: 1.3;
  }

  .homepage-promo-tile__link-label {
    display: inline-block;
    margin-block-start: var(--gap-xs);
  }

  .homepage-promo-tile__link:focus-visible {
    outline: 3px solid var(--color-foreground);
    outline-offset: -3px;
  }

  @media screen and (min-width: 992px) {
    .homepage-promo-tiles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--gap-md);
      row-gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.multicolumn",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "promo_tile",
      "name": "t:names.card",
      "settings": [
        {
          "type": "url",
          "id": "external_image_url",
          "label": "t:settings.external_image_url"
        },
        {
          "type": "text",
          "id": "external_image_alt",
          "label": "t:settings.external_image_alt"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image",
          "visible_if": "{{ block.settings.external_image_url == blank }}"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "t:settings.open_new_tab",
          "default": false
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:settings.text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "t:names.multicolumn",
      "blocks": [
        {
          "type": "promo_tile"
        },
        {
          "type": "promo_tile"
        },
        {
          "type": "promo_tile"
        }
      ]
    }
  ]
}
{% endschema %}
