{% comment %}
  Section contract.
  Displays the public, image-only Weekly Specials feed maintained by the legacy admin.
  @example
  <!-- Add to the Weekly Specials page template and configure its HTTPS feed URL. -->
{% endcomment %}

<section
  class="weekly-specials section spacing-style"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  aria-labelledby="WeeklySpecialsHeading-{{ section.id }}"
  data-weekly-specials
  data-feed-url="{{ section.settings.feed_url | escape }}"
  data-config-error="{{ 'weekly_specials.not_configured' | t | escape }}"
  data-load-error="{{ 'weekly_specials.load_error' | t | escape }}"
  data-empty-message="{{ 'weekly_specials.empty' | t | escape }}"
  data-image-error="{{ 'weekly_specials.image_error' | t | escape }}"
>
  <div class="weekly-specials__content page-width-content">
    <h1 class="weekly-specials__heading h2" id="WeeklySpecialsHeading-{{ section.id }}">
      {{ section.settings.heading | escape }}
    </h1>
    <p class="weekly-specials__status" role="status" aria-live="polite" aria-atomic="true" data-weekly-status>
      {{ 'weekly_specials.loading' | t }}
    </p>
    <p class="weekly-specials__empty" data-weekly-empty hidden></p>
    <ul class="weekly-specials__list" aria-label="{{ 'weekly_specials.heading' | t | escape }}" data-weekly-list hidden></ul>
  </div>
</section>

{% stylesheet %}
  .weekly-specials__content {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .weekly-specials__heading {
    margin-block: 0 var(--gap-lg);
    color: var(--color-foreground);
  }

  .weekly-specials__status,
  .weekly-specials__empty {
    margin-block: 0 var(--gap-md);
  }

  .weekly-specials__status:empty {
    display: none;
  }

  .weekly-specials__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--gap-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .weekly-specials__item {
    min-width: 0;
  }

  .weekly-specials__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    background: var(--color-background);
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .weekly-specials__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.weekly_specials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Weekly Specials"
    },
    {
      "type": "url",
      "id": "feed_url",
      "label": "t:settings.weekly_specials_feed_url",
      "info": "t:content.weekly_specials_feed_url_info"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
