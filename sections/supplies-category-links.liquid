{% liquid
  # Mirrors scripts/supplies-collections.json; keep the labels and handles aligned.
  assign category_entries = "Adhesives|adhesives^Bags/Sleeves|bags-sleeves^Balloons|balloons^Baskets|baskets^Buckets|buckets^Candle Holders|candle-holders^Candles|candles^Card Picks|card-picks^Cards|cards^Ceramic Containers|ceramic-containers^Chenille Stems|chenille-stems^Christmas Items|christmas-items^Decorative Containers|decorative-containers^Display Items|display-items^Dried/Preserved Flowers|dried-preserved-flowers^Dry Foam & Styrofoam|dry-foam-styrofoam^Dyes/Glitter|dyes-glitter^Event Lighting|event-lighting^Fall Items|fall-items^Feathers|feathers^Floral Bags / Wraps|floral-bags-wraps^Flower Boxes|flower-boxes^Foam & Oasis|foam-oasis^Foil/Mesh|foil-mesh^Forms/Tags|forms-tags^Fruits/Berries|fruits-berries^Funeral Items|funeral-items^Giftware|giftware^Hardware/Tools|hardware-tools^Holiday Items|holiday-items^Marbles \ Vase Filler|marbles-vase-filler^Mother's Day Supplies|mothers-day-supplies^Novelty Birds/Bugs|novelty-birds-bugs^Novelty Misc.|novelty-misc^Novelty Pick|novelty-pick^Paper Sleeves|paper-sleeves^Paper Tissue/Shred|paper-tissue-shred^Picks (Plastic, Metal, Wood)|picks-plastic-metal-wood^Plant Accessories|plant-accessories^Plant Pots/Saucers|plant-pots-saucers^Plastic Containers|plastic-containers^Plastic Flowers/Fruit|plastic-flowers-fruit^Pot Covers|pot-covers^Preservatives|preservatives^Prom & Wedding|prom-wedding^Ribbon|ribbon^Seasonal Items|seasonal-items^Shells - Seashells|shells-seashells^Silk Flowers|silk-flowers^Silk Greens/Foliage|silk-greens-foliage^Silk Plants|silk-plants^Special Order Items|special-order-items^Spray Paint|spray-paint^Stem Wrap/ Tape|stem-wrap-tape^Stuffed Animals|stuffed-animals^Tissue/Wrap|tissue-wrap^Vases|vases^Water Tubes|water-tubes^Wedding Supplies|wedding-supplies^Wire Items|wire-items^Wreaths|wreaths" | split: '^' | sort_natural
%}

{% if collection.handle == 'supplies' %}
  <div
    class="section section--page-width spacing-style supplies-category-links"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    <ul class="supplies-category-links__list" role="list">
      {% for category_entry in category_entries %}
        {% assign category_parts = category_entry | split: '|' %}
        {% assign category_name = category_parts[0] %}
        {% assign category_handle = category_parts[1] %}
        <li class="supplies-category-links__item">
          <a class="supplies-category-links__link" href="{{ routes.collections_url }}/{{ category_handle | escape }}">
            {{ category_name | escape }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% stylesheet %}
  .supplies-category-links__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-md) var(--gap-2xl);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .supplies-category-links__item {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .supplies-category-links__link {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_links_text",
  "class": "supplies-category-links-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "All Supplies Categories"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_links_text"
    }
  ]
}
{% endschema %}
