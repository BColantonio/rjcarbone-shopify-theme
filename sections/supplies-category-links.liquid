{% liquid
  capture category_entry_data
    render 'supplies-category-data'
  endcapture
  assign category_entries = category_entry_data | strip | split: '^' | sort_natural
  assign category_count = category_entries.size
  assign section_collections = section.settings.collection_list
  if section_collections != blank
    assign max_items = section_collections.count
  elsif section.settings.layout_type == 'editorial'
    assign max_items = section.settings.max_collections
  elsif section.settings.layout_type == 'bento'
    assign max_items = 4
  elsif section.settings.layout_type == 'carousel'
    assign max_items = section.settings.columns | plus: 2
  elsif section.settings.layout_type == 'grid'
    assign max_items = section.settings.columns
  endif
  capture plants_department
    render 'floral-department-back-link-plants', collection_handle: collection.handle
  endcapture
  assign plants_department = plants_department | strip
  assign floral_department = plants_department
  if floral_department == blank
    if collection.handle == 'flowers'
      assign floral_department = 'flowers'
    else
      capture floral_department
        render 'floral-department-back-link-flowers', collection_handle: collection.handle
      endcapture
      assign floral_department = floral_department | strip
    endif
  endif
  if floral_department == blank
    if collection.handle == 'roses'
      assign floral_department = 'roses'
    else
      capture floral_department
        render 'floral-department-back-link-roses', collection_handle: collection.handle
      endcapture
      assign floral_department = floral_department | strip
    endif
  endif
  if floral_department == blank
    if collection.handle == 'greens'
      assign floral_department = 'greens'
    else
      capture floral_department
        render 'floral-department-back-link-greens', collection_handle: collection.handle
      endcapture
      assign floral_department = floral_department | strip
    endif
  endif
  if floral_department == 'plants' or floral_department == 'flowers' or floral_department == 'roses' or floral_department == 'greens'
    capture floral_category_links
      render 'floral-department-category-links', collection_handle: floral_department
    endcapture
    assign category_count = floral_category_links | split: '<li' | size | minus: 1
  else
    capture floral_category_links
      render 'floral-department-category-links', collection_handle: collection.handle
    endcapture
  endif
  assign category_heading_key = 'collection_links.all_supply_types'
  assign category_heading_fallback = 'All Supply Types'
  assign category_browse_key = 'collection_links.browse_supply_types'
  assign category_browse_fallback = 'Browse Supply Types'
  if collection.handle != 'supplies'
    case floral_department
      when 'flowers'
        assign category_heading_key = 'collection_links.all_flower_types'
        assign category_heading_fallback = 'All Flower Types'
        assign category_browse_key = 'collection_links.browse_flower_types'
        assign category_browse_fallback = 'Browse Flower Types'
      when 'roses'
        assign category_heading_key = 'collection_links.all_rose_types'
        assign category_heading_fallback = 'All Rose Types'
        assign category_browse_key = 'collection_links.browse_rose_types'
        assign category_browse_fallback = 'Browse Rose Types'
      when 'greens'
        assign category_heading_key = 'collection_links.all_greenery_types'
        assign category_heading_fallback = 'All Greenery Types'
        assign category_browse_key = 'collection_links.browse_greenery_types'
        assign category_browse_fallback = 'Browse Greenery Types'
      when 'plants'
        assign category_heading_key = 'collection_links.all_plant_types'
        assign category_heading_fallback = 'All Plant Types'
        assign category_browse_key = 'collection_links.browse_plant_types'
        assign category_browse_fallback = 'Browse Plant Types'
    endcase
  endif
  capture translated_category_heading
    echo category_heading_key | t
  endcapture
  assign translated_category_heading = translated_category_heading | strip
  assign translated_category_heading_lowercase = translated_category_heading | downcase
  if translated_category_heading == category_heading_key or translated_category_heading_lowercase contains 'translation missing'
    assign translated_category_heading = category_heading_fallback
  endif
  if collection.handle == 'supplies' and section.settings.category_heading != blank and section.settings.category_heading != 'All Supplies Categories' and section.settings.category_heading != 'All Supply Types'
    assign translated_category_heading = section.settings.category_heading
  endif
  capture translated_category_browse
    echo category_browse_key | t: count: category_count
  endcapture
  assign translated_category_browse = translated_category_browse | strip
  assign translated_category_browse_lowercase = translated_category_browse | downcase
  if translated_category_browse == category_browse_key or translated_category_browse_lowercase contains 'translation missing'
    assign translated_category_browse = category_browse_fallback | append: ' (' | append: category_count | append: ')'
  endif
  assign show_department_categories = false
  if collection.handle == 'supplies' or floral_department == 'plants' or floral_department == 'flowers' or floral_department == 'roses' or floral_department == 'greens'
    assign show_department_categories = true
  endif
  assign show_featured_categories = true
  if section.settings.hide_when_empty and section_collections == blank
    assign show_featured_categories = false
  endif
  if section.settings.supplies_only and collection.handle != 'supplies'
    assign show_featured_categories = false
  endif
%}

{% if show_department_categories %}
  {% if section.settings.background_color != blank %}
    {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
  {% endif %}
  <div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} section-resource-list spacing-style gap-style supplies-category-links supplies-category-links--department"
    style="{% render 'spacing-style', settings: section.settings %}{% render 'gap-style', value: section.settings.gap %}"
  >
    <h2 class="h2 supplies-category-links__heading">{{ translated_category_heading | escape }}</h2>
    <details class="supplies-category-links__disclosure">
      <summary class="supplies-category-links__summary">
        <span>{{ translated_category_browse | escape }}</span>
        <span class="supplies-category-links__indicator" aria-hidden="true"></span>
      </summary>
      {% if show_featured_categories %}
        <div
          class="supplies-category-links__featured"
          style="padding-block: {{ section.settings.featured_padding_block_start }}px {{ section.settings.featured_padding_block_end }}px;"
        >
          {% if section.settings.heading != blank %}
            <h3 class="h2 supplies-category-links__featured-heading">{{ section.settings.heading | escape }}</h3>
          {% endif %}
          {% if section_collections == null %}
            {% for i in (1..max_items) %}
              {% assign section_collections = section_collections | append: ', ' %}
            {% endfor %}
            {% assign section_collections = section_collections | split: ',' %}
          {% endif %}
          {% capture list_items %}
            {% for featured_collection in section_collections limit: max_items %}
              <div class="resource-list__item">
                {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: featured_collection %}
              </div>
              {% unless forloop.last %}
                <!--@list/split-->
              {% endunless %}
            {% endfor %}
          {% endcapture %}
          {% liquid
            assign list_items_array = list_items | strip | split: '<!--@list/split-->'
          %}
          {% render 'resource-list',
            list_items: list_items,
            list_items_array: list_items_array,
            settings: section.settings,
            carousel_ref: 'collectionList',
            slide_count: max_items,
            content_type: 'collections',
            test_id: 'collections-list-grid'
          %}
        </div>
      {% endif %}
      {% if collection.handle == 'supplies' %}
        <ul class="supplies-category-links__list" role="list">
          {% for category_entry in category_entries %}
            {% assign category_parts = category_entry | split: '|' %}
            {% assign category_name = category_parts[0] %}
            {% assign category_handle = category_parts[1] %}
            <li class="supplies-category-links__item">
              <a class="supplies-category-links__link" href="{{ routes.collections_url }}/{{ category_handle | escape }}">
                {{ category_name | escape }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        {{ floral_category_links }}
      {% endif %}
    </details>
  </div>
{% elsif floral_category_links != blank %}
  <div
    class="section section--page-width spacing-style supplies-category-links"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {{ floral_category_links }}
  </div>
{% endif %}

{% stylesheet %}
  .supplies-category-links--department {
    min-width: 0;
  }

  .supplies-category-links--department .supplies-category-links__heading.h2 {
    margin-block: 0 0.75rem;
    font-size: clamp(1.35rem, 2vw, 1.5rem);
    line-height: 1.2;
  }

  .supplies-category-links--department .supplies-category-links__list {
    columns: 4;
    column-gap: var(--gap-2xl);
    list-style: none;
    margin: var(--gap-md) 0 0;
    padding: 0;
  }

  .supplies-category-links--department .supplies-category-links__summary {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    padding: var(--gap-sm) var(--gap-md);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: var(--style-border-radius-buttons-primary);
    color: #07545a;
    cursor: pointer;
    list-style: none;
  }

  .supplies-category-links--department .supplies-category-links__summary::-webkit-details-marker {
    display: none;
  }

  .supplies-category-links--department .supplies-category-links__summary:focus-visible {
    outline: 3px solid #07545a;
    outline-offset: 3px;
  }

  .supplies-category-links--department .supplies-category-links__indicator {
    width: 0.65rem;
    height: 0.65rem;
    flex: 0 0 auto;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.15rem) rotate(45deg);
    transition: transform 160ms ease;
  }

  .supplies-category-links--department details[open] .supplies-category-links__indicator {
    transform: translateY(0.15rem) rotate(225deg);
  }

  .supplies-category-links--department .supplies-category-links__item {
    min-width: 0;
    margin-block-end: var(--gap-sm);
    overflow-wrap: anywhere;
    break-inside: avoid;
  }

  .supplies-category-links--department .supplies-category-links__link {
    display: inline-block;
    max-width: 100%;
    color: #07545a;
    text-underline-offset: 0.2em;
  }

  .supplies-category-links--department .supplies-category-links__link:hover {
    text-decoration-color: #0e9ca4;
  }

  .supplies-category-links--department .supplies-category-links__link:focus-visible {
    border-radius: 2px;
    outline: 3px solid #07545a;
    outline-offset: 3px;
  }

  .supplies-category-links--department .supplies-category-links__featured {
    min-width: 0;
  }

  .supplies-category-links--department .supplies-category-links__featured-heading {
    margin-block: 0 0.75rem;
    font-size: clamp(1.5rem, 2.2vw, 1.75rem);
    line-height: 1.2;
  }

  .supplies-category-links--department .resource-list--grid {
    align-items: start;
  }

  .supplies-category-links--department .resource-list__item,
  .supplies-category-links--department .collection-card,
  .supplies-category-links--department .collection-card__inner,
  .supplies-category-links--department .collection-card__content {
    min-width: 0;
    height: auto;
  }

  .supplies-category-links--department .collection-card__inner {
    gap: var(--gap-sm);
  }

  .supplies-category-links--department .collection-card__image {
    width: 100%;
    height: 112px;
    min-height: 112px;
    max-height: none;
    aspect-ratio: auto;
  }

  .supplies-category-links--department .collection-card__image .resource-image__image {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: contain;
  }

  .supplies-category-links--department .collection-card__content {
    justify-content: center;
  }

  .supplies-category-links--department .collection-card__content .text-block {
    width: 100%;
    max-width: 100%;
    padding: 0;
    color: #07545a;
    text-align: center;
    background: transparent;
  }

  .supplies-category-links--department .collection-card__link:focus-visible {
    z-index: 1;
    outline: 3px solid #07545a;
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .supplies-category-links--department .supplies-category-links__list {
      columns: 2;
    }

    .supplies-category-links--department .resource-list--grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .supplies-category-links--department .supplies-category-links__list {
      columns: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .supplies-category-links--department .supplies-category-links__indicator {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_links_text",
  "class": "supplies-category-links-section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "category_heading",
      "label": "t:settings.heading",
      "default": "All Supply Types"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:settings.collection_list"
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "t:settings.visibility",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "supplies_only",
      "label": "t:settings.visibility",
      "default": false
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "bento",
          "label": "t:options.bento"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "bento_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'bento' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "range",
      "id": "max_collections",
      "label": "t:settings.collection_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'editorial' }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "featured_padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "featured_padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_links_text",
      "blocks": {
        "static-collection-card": {
          "type": "_collection-card",
          "name": "t:names.collection_card",
          "static": true,
          "settings": {
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "flex-end",
            "placement": "below_image",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0
          },
          "blocks": {
            "collection-card-image": {
              "type": "_collection-card-image",
              "name": "t:names.collection_card_image",
              "static": true,
              "settings": {
                "image_ratio": "landscape"
              }
            },
            "collection-title": {
              "type": "collection-title",
              "name": "t:names.collection_title",
              "settings": {
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "background": false,
                "background_color": "#ffffff",
                "text_color": "#07545A",
                "padding-block-start": 4,
                "padding-block-end": 4,
                "padding-inline-start": 8,
                "padding-inline-end": 8
              }
            }
          },
          "block_order": [
            "collection-title"
          ]
        }
      },
      "block_order": []
    }
  ]
}
{% endschema %}
