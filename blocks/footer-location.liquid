{% liquid
  assign location_name = block.settings.location_name | strip
  assign address = block.settings.address | strip
  assign phone = block.settings.phone | strip
%}

{% if location_name != blank or address != blank or phone != blank %}
  <address class="footer-location" {{ block.shopify_attributes }}>
    {% if location_name != blank %}
      <h3 class="footer-location__name">{{ location_name | escape }}</h3>
    {% endif %}
    {% if address != blank %}
      <p>{{ address | escape | newline_to_br }}</p>
    {% endif %}
    {% if phone != blank %}
      <p><a href="tel:{{ phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | escape }}">{{ phone | escape }}</a></p>
    {% endif %}
  </address>
{% endif %}

{% stylesheet %}
  .footer-location {
    margin: 0;
    font-style: normal;
    overflow-wrap: anywhere;
  }

  .footer-location__name,
  .footer-location p {
    margin: 0;
  }

  .footer-location__name {
    margin-block-end: var(--gap-xs);
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .footer-location a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .footer-location a:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.text",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "location_name",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "t:settings.text"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:settings.text"
    }
  ]
}
{% endschema %}
