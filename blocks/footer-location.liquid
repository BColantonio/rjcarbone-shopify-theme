{% liquid
  assign location_name = block.settings.location_name | strip
  assign address = block.settings.address | strip
  assign phone = block.settings.phone | strip
%}

{% if location_name != blank or address != blank or phone != blank %}
  {% render 'location-details',
    location_name: location_name,
    address: address,
    phone: phone,
    block: block,
    context: 'footer'
  %}
{% endif %}

{% schema %}
{
  "name": "t:names.text",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "location_name",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "t:settings.location_address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:settings.location_phone"
    }
  ]
}
{% endschema %}
